<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.stylesimplified.backend.controllers.WardrobeController">
   <stylesheets>
      <URL value="@style.css" />
   </stylesheets>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Button mnemonicParsing="false" onAction="#handleBackButton" text="&lt; Back" />
         </children>
      </HBox>
      <Label text="Wardrobe">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Button mnemonicParsing="false" onAction="#handleAddItemButton" prefHeight="40.0" prefWidth="200.0" text="Add New Item" />
      <ScrollPane opacity="1.0" prefHeight="591.0" prefWidth="560.0">
         <content>
            <TilePane fx:id="clothesCard" alignment="TOP_CENTER" hgap="15.0" prefHeight="200.0" prefWidth="200.0" vgap="20.0" />
         </content>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </ScrollPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
