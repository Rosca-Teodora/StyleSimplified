<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="521.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.stylesimplified.backend.controllers.WardrobeController">
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Button mnemonicParsing="false" onAction="#handleBackButton" text="&lt; Back" />
         </children>
      </HBox>
      <Label text="Wardrobe">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Button mnemonicParsing="false" onAction="#handleAddItemButton" prefHeight="40.0" prefWidth="200.0" text="Add New Item" />
      <ScrollPane opacity="1.0" prefHeight="304.0" prefWidth="560.0">
         <content>
            <TilePane fx:id="clothesCard" alignment="TOP_CENTER" hgap="15.0" prefHeight="200.0" prefWidth="200.0" vgap="20.0" />
         </content>
      </ScrollPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
