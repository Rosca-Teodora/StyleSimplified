<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="682.0" prefWidth="500.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.stylesimplified.AddItemController">
    <children>
        <Label text="Add a New Clothing Item">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Name:" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Image Path:" GridPane.rowIndex="1" />
                <TextField fx:id="imagePathField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Type:" GridPane.rowIndex="2" />
                <ChoiceBox fx:id="typeChoiceBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <!-- Container for Top specific inputs -->
        <AnchorPane fx:id="topInputsContainer" managed="false" visible="false">
            <children>
                <GridPane prefWidth="460.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Sleeve Length:" />
                        <TextField fx:id="sleeveInput" GridPane.columnIndex="1" />
                        <Label text="Neckline:" GridPane.rowIndex="1" />
                        <TextField fx:id="necklineInput" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Is Outerwear?" GridPane.rowIndex="2" />
                        <ToggleButton fx:id="isOuterwearInput" mnemonicParsing="false" text="Yes" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>
            </children>
        </AnchorPane>

        <!-- Container for Bottom specific inputs -->
        <AnchorPane fx:id="bottomInputsContainer" managed="false" visible="false">
            <children>
                <GridPane prefWidth="460.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Fit Type:" />
                        <TextField fx:id="fitTypeInput" GridPane.columnIndex="1" />
                        <Label text="Waist Rise:" GridPane.rowIndex="1" />
                        <TextField fx:id="waistRiseInput" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Length:" GridPane.rowIndex="2" />
                        <TextField fx:id="lengthInput" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>
            </children>
        </AnchorPane>

        <!-- Container for Accessory specific inputs -->
        <AnchorPane fx:id="accessoryInputsContainer" managed="false" visible="false">
            <children>
                <GridPane prefWidth="460.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Placement:" />
                        <TextField fx:id="placementInput" GridPane.columnIndex="1" />
                        <Label text="Material:" GridPane.rowIndex="1" />
                        <TextField fx:id="materialInput" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Accessory Type:" GridPane.rowIndex="2" />
                        <TextField fx:id="accessoryTypeInput" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>
            </children>
        </AnchorPane>

        <Button onAction="#handleAddItemButton" text="Add Item" />
        <Label fx:id="statusLabel" textFill="GREEN" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
