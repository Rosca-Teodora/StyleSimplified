<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="521.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.stylesimplified.backend.controllers.TagsController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Button mnemonicParsing="false" onAction="#handleBackButton" text="&lt; Back" />
            </children>
        </HBox>
        <Label text="Tags">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <HBox prefHeight="35.0" prefWidth="560.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleAddTagButton" prefHeight="32.0" prefWidth="135.0" text="Add new tag" />
                <Separator orientation="VERTICAL" prefHeight="37.0" prefWidth="27.0" />
                <TextField fx:id="nameField" prefHeight="35.0" prefWidth="400.0" promptText="Enter tag name..." />
            </children>
        </HBox>
        <ScrollPane opacity="1.0" prefHeight="304.0" prefWidth="560.0">
            <content>
                <VBox fx:id="tagsContainer" spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>